{
  "name": "tutu",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src tests tools --ext .ts --max-warnings 0",
    "lint:fix": "eslint src tests tools --ext .ts --fix",
    "format": "prettier --write \"{src,tests,tools}/**/*.{ts,css}\"",
    "format:check": "prettier --check \"{src,tests,tools}/**/*.{ts,css}\"",
    "type:check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "gen:icons": "tsx tools/gen-icons.ts",
    "gen:levels": "tsx tools/build-levels.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
